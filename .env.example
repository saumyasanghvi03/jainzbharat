# =============================================================================
# JainZBharat — Environment Variables
# =============================================================================
# Copy this file to .env.local and fill in your values.
# For Vercel: add all variables in Project Settings > Environment Variables.
# =============================================================================

# ── Application ────────────────────────────────────────────────────────────

# Public canonical URL used for metadata, QR verification, RSS, and sitemaps.
# Development: http://localhost:3000
# Preview: https://preview-*.vercel.app
# Production: https://yourdomain.com
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Clerk (Authentication) ─────────────────────────────────────────────────
# Create an app at https://dashboard.clerk.com
# Enable Google, GitHub, and Email providers under User & Authentication.
# Development keys start with pk_test_ / sk_test_
# Production keys start with pk_live_ / sk_live_

# Publishable key (safe for client-side, starts with pk_)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_replace_me
# Secret key (server-side only, starts with sk_)
CLERK_SECRET_KEY=sk_test_replace_me

# Clerk routing paths
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard

# Fallback redirect URLs
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/

# ── Supabase (PostgreSQL + Storage) ────────────────────────────────────────
# Create a project at https://supabase.com
# Run migrations from supabase/migrations/ in order via SQL Editor.

# Project URL (found in Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# Anon/public key (safe for client-side, enables RLS)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
# Service role key (server-side only, bypasses RLS)
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# ── Resend (Transactional Email) ───────────────────────────────────────────
# Create an API key at https://resend.com/api-keys

RESEND_API_KEY=re_replace_me

# ── PostHog (Product Analytics) ────────────────────────────────────────────
# Create a project at https://app.posthog.com

NEXT_PUBLIC_POSTHOG_KEY=phc_replace_me
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# ── Sentry (Error Monitoring) ──────────────────────────────────────────────
# Create a project at https://sentry.io

NEXT_PUBLIC_SENTRY_DSN=https://replace-me@sentry.io/project

# ── Mapbox (Maps & Globe) ──────────────────────────────────────────────────
# Create an access token at https://account.mapbox.com

NEXT_PUBLIC_MAPBOX_TOKEN=pk.replace_me

# ── Stripe (Payments — Future) ─────────────────────────────────────────────
# Create keys at https://dashboard.stripe.com/apikeys

STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
